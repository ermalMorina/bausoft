# API Configuration
# Backend GraphQL endpoint. Must be prefixed with EXPO_PUBLIC_ to be exposed to the app.
#
# iOS Simulator / web:      http://localhost:4000/graphql
# Android emulator:         http://10.0.2.2:4000/graphql
# Physical device:          http://<your-computer-LAN-IP>:4000/graphql  (e.g. 192.168.1.50)
EXPO_PUBLIC_API_URL=http://localhost:4000/graphql

# Environment
NODE_ENV=development

# Optional: Feature flags, API keys, etc.
# EXPO_PUBLIC_FEATURE_FLAG=true
