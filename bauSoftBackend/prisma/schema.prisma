generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String
  company_name    String?
  company_address String?
  vat_number      String?
  created_at      DateTime @default(now())

  // Workforce / employee profile
  role              String   @default("WORKER") // ADMIN, PROJECT_MANAGER, SUPERVISOR, WORKER
  phone             String?
  position          String?
  skills            String? // comma separated
  avatar_url        String?
  employee_code     String?
  employment_status String   @default("ACTIVE") // ACTIVE, INACTIVE, ON_LEAVE, SICK, UNAVAILABLE
  date_joined       DateTime @default(now())
  emergency_contact String?
  current_site_id   Int?
  current_team_id   Int?

  clients  Client[]
  invoices Invoice[]

  // Workforce relations
  current_site    Site?          @relation("UserCurrentSite", fields: [current_site_id], references: [id])
  current_team    Team?          @relation("TeamMembers", fields: [current_team_id], references: [id])
  led_teams       Team[]         @relation("TeamLeader")
  managed_sites   Site[]         @relation("SiteProjectManager")
  assignments     Assignment[]   @relation("EmployeeAssignments")
  tasks           Task[]         @relation("TaskAssignee")
  daily_reports   DailyReport[]  @relation("ReportEmployee")
  attendance      Attendance[]   @relation("AttendanceEmployee")
  activities      Activity[]     @relation("ActivityEmployee")
  reported_issues Issue[]        @relation("IssueReporter")
  assigned_issues Issue[]        @relation("IssueAssignee")
  authored_notes  Note[]         @relation("NoteAuthor")
  subject_notes   Note[]         @relation("NoteSubjectEmployee")
  chat_messages   ChatMessage[]  @relation("MessageSender")
  announcements   Announcement[] @relation("AnnouncementAuthor")
  notifications   Notification[] @relation("UserNotifications")
  audit_logs      AuditLog[]     @relation("AuditActor")
}

model Site {
  id                  Int       @id @default(autoincrement())
  name                String
  address             String?
  latitude            Float?
  longitude           Float?
  radius_m            Int       @default(200)
  client_name         String?
  project_name        String?
  description         String?
  start_date          DateTime?
  expected_completion DateTime?
  status              String    @default("PLANNED") // PLANNED, ACTIVE, PAUSED, COMPLETED, CANCELLED
  project_manager_id  Int?
  created_at          DateTime  @default(now())

  project_manager User?          @relation("SiteProjectManager", fields: [project_manager_id], references: [id])
  current_members User[]         @relation("UserCurrentSite")
  teams           Team[]         @relation("TeamSite")
  assignments     Assignment[]   @relation("SiteAssignments")
  tasks           Task[]         @relation("SiteTasks")
  daily_reports   DailyReport[]  @relation("ReportSite")
  attendance      Attendance[]   @relation("AttendanceSite")
  activities      Activity[]     @relation("ActivitySite")
  issues          Issue[]        @relation("IssueSite")
  notes           Note[]         @relation("NoteSite")
  chat_messages   ChatMessage[]  @relation("SiteMessages")
  announcements   Announcement[] @relation("SiteAnnouncements")
}

model Team {
  id         Int      @id @default(autoincrement())
  name       String
  status     String   @default("ACTIVE") // ACTIVE, INACTIVE
  site_id    Int?
  leader_id  Int?
  created_at DateTime @default(now())

  site          Site?         @relation("TeamSite", fields: [site_id], references: [id])
  leader        User?         @relation("TeamLeader", fields: [leader_id], references: [id])
  members       User[]        @relation("TeamMembers")
  assignments   Assignment[]  @relation("TeamAssignments")
  tasks         Task[]        @relation("TeamTasks")
  daily_reports DailyReport[] @relation("ReportTeam")
  attendance    Attendance[]  @relation("AttendanceTeam")
  chat_messages ChatMessage[] @relation("TeamMessages")
  notes         Note[]        @relation("NoteTeam")
}

model Assignment {
  id          Int       @id @default(autoincrement())
  employee_id Int
  site_id     Int
  team_id     Int?
  start_date  DateTime  @default(now())
  end_date    DateTime?
  created_at  DateTime  @default(now())

  employee User  @relation("EmployeeAssignments", fields: [employee_id], references: [id], onDelete: Cascade)
  site     Site  @relation("SiteAssignments", fields: [site_id], references: [id], onDelete: Cascade)
  team     Team? @relation("TeamAssignments", fields: [team_id], references: [id])
}

model Task {
  id             Int      @id @default(autoincrement())
  site_id        Int
  team_id        Int?
  assignee_id    Int?
  title          String
  description    String?
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  date           DateTime @default(now())
  expected_start String?
  expected_end   String?
  status         String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, BLOCKED, CANCELLED
  notes          String?
  created_at     DateTime @default(now())

  site     Site  @relation("SiteTasks", fields: [site_id], references: [id], onDelete: Cascade)
  team     Team? @relation("TeamTasks", fields: [team_id], references: [id])
  assignee User? @relation("TaskAssignee", fields: [assignee_id], references: [id])
}

model DailyReport {
  id             Int      @id @default(autoincrement())
  site_id        Int
  team_id        Int?
  employee_id    Int
  date           DateTime @default(now())
  completed      String?
  in_progress    String?
  planned_next   String?
  notes          String?
  issues         String?
  materials      String?
  photos         String? // comma separated URLs
  check_in_time  String?
  check_out_time String?
  created_at     DateTime @default(now())

  site     Site  @relation("ReportSite", fields: [site_id], references: [id], onDelete: Cascade)
  team     Team? @relation("ReportTeam", fields: [team_id], references: [id])
  employee User  @relation("ReportEmployee", fields: [employee_id], references: [id], onDelete: Cascade)
}

model Attendance {
  id              Int       @id @default(autoincrement())
  employee_id     Int
  site_id         Int
  team_id         Int?
  check_in        DateTime  @default(now())
  check_out       DateTime?
  check_in_lat    Float?
  check_in_lng    Float?
  check_out_lat   Float?
  check_out_lng   Float?
  within_geofence Boolean   @default(true)
  status          String    @default("WORKING") // WORKING, COMPLETED
  created_at      DateTime  @default(now())

  employee User  @relation("AttendanceEmployee", fields: [employee_id], references: [id], onDelete: Cascade)
  site     Site  @relation("AttendanceSite", fields: [site_id], references: [id], onDelete: Cascade)
  team     Team? @relation("AttendanceTeam", fields: [team_id], references: [id])
}

model Activity {
  id          Int      @id @default(autoincrement())
  employee_id Int
  site_id     Int?
  state       String   @default("WORKING") // WORKING, BREAK, WAITING, TRAVELING, MEETING, OTHER
  description String?
  created_at  DateTime @default(now())

  employee User  @relation("ActivityEmployee", fields: [employee_id], references: [id], onDelete: Cascade)
  site     Site? @relation("ActivitySite", fields: [site_id], references: [id])
}

model Issue {
  id             Int      @id @default(autoincrement())
  site_id        Int
  reported_by_id Int
  assigned_to_id Int?
  title          String
  description    String?
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  status         String   @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  photos         String?
  created_at     DateTime @default(now())

  site        Site  @relation("IssueSite", fields: [site_id], references: [id], onDelete: Cascade)
  reported_by User  @relation("IssueReporter", fields: [reported_by_id], references: [id])
  assigned_to User? @relation("IssueAssignee", fields: [assigned_to_id], references: [id])
}

model Note {
  id          Int      @id @default(autoincrement())
  author_id   Int
  site_id     Int?
  task_id     Int?
  team_id     Int?
  employee_id Int?
  body        String
  priority    String   @default("NORMAL") // NORMAL, HIGH
  photos      String?
  created_at  DateTime @default(now())

  author   User  @relation("NoteAuthor", fields: [author_id], references: [id])
  site     Site? @relation("NoteSite", fields: [site_id], references: [id], onDelete: Cascade)
  team     Team? @relation("NoteTeam", fields: [team_id], references: [id])
  employee User? @relation("NoteSubjectEmployee", fields: [employee_id], references: [id])
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  team_id    Int?
  site_id    Int?
  sender_id  Int
  body       String
  created_at DateTime @default(now())

  team   Team? @relation("TeamMessages", fields: [team_id], references: [id], onDelete: Cascade)
  site   Site? @relation("SiteMessages", fields: [site_id], references: [id], onDelete: Cascade)
  sender User  @relation("MessageSender", fields: [sender_id], references: [id])
}

model Announcement {
  id         Int      @id @default(autoincrement())
  site_id    Int
  author_id  Int
  body       String
  created_at DateTime @default(now())

  site   Site @relation("SiteAnnouncements", fields: [site_id], references: [id], onDelete: Cascade)
  author User @relation("AnnouncementAuthor", fields: [author_id], references: [id])
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  type       String
  body       String
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actor_id   Int?
  action     String
  entity     String?
  created_at DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actor_id], references: [id])
}

model Client {
  id         Int      @id @default(autoincrement())
  user_id    Int
  name       String
  address    String?
  email      String?
  phone      String?
  created_at DateTime @default(now())

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  invoices Invoice[]
}

model Invoice {
  id             Int      @id @default(autoincrement())
  user_id        Int
  client_id      Int
  invoice_number String   @unique
  issue_date     DateTime
  due_date       DateTime
  status         String   @default("draft") // draft, sent, paid, overdue
  subtotal       Decimal  @default(0)
  tax_total      Decimal  @default(0)
  total          Decimal  @default(0)
  created_at     DateTime @default(now())

  user   User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  client Client        @relation(fields: [client_id], references: [id], onDelete: Cascade)
  items  InvoiceItem[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoice_id  Int
  description String
  quantity    Decimal @default(1)
  unit_price  Decimal
  tax_rate    Decimal @default(0)
  line_total  Decimal @default(0)

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
}
